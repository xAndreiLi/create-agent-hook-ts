{
	"name": "create-agent-hook-ts",
	"description": "A TypeScript library for creating agent hooks.",
	"version": "1.0.0",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/xAndreiLi/create-agent-hook-ts"
	},
	"type": "module",
	"files": [
		"dist"
	],
	"module": "./dist/index.js",
	"main": "./dist/index.cjs",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"clean": "rm -rf dist .tsbuildinfo",
		"build": "tsc && bunup",
		"format": "biome format --write",
		"lint": "bun run format && biome check",
		"test": "bun run lint"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.7",
		"@types/bun": "latest",
		"bunup": "^0.16.31"
	},
	"peerDependencies": {
		"typescript": "^5"
	}
}
